NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Live event provider:
#   tikfinity = receive events from TikFinity Desktop over WebSocket (Windows app).
#   tiktok    = connect directly to TikTok LIVE via tiktok-live-connector.
# If unset, the bridge picks a platform default:
#   Windows -> tikfinity, macOS/Linux -> tiktok.
LIVE_PROVIDER=tikfinity
TIKFINITY_WS_URL=ws://127.0.0.1:21213/

# Optional API key for the direct TikTok provider (tiktok-live-connector).
# EULER_API_KEY=

# Keep disabled unless you intentionally expose the bridge to a trusted LAN.
ALLOW_LAN=0
