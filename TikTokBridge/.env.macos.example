NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# macOS recommended provider: connect directly to TikTok LIVE.
# TikFinity Desktop is a Windows application; only set LIVE_PROVIDER=tikfinity
# on macOS if you run a TikFinity-compatible WebSocket relay yourself.
LIVE_PROVIDER=tiktok

# Keep disabled unless you intentionally expose the bridge to a trusted LAN.
ALLOW_LAN=0
